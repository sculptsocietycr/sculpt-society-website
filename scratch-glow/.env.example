# Copiá este archivo a `.env` y completá los valores.
# En producción se configuran como Environment Variables en Netlify
# (Settings → Build & deploy → Environment).

# Clave para el panel admin (Bearer token). Usá una contraseña larga.
ADMIN_PASSWORD=cambia-esto

# Opcional: máximo de participantes (default: 25).
# MAX_PARTICIPANTS=25

# Netlify Blobs se autoconfigura solito cuando corrés `netlify dev` o
# desplegás en Netlify. No hace falta nada más.
